{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.v1.schema.json",
  "title": "Distributed event envelope",
  "type": "object",
  "required": [
    "messageId",
    "correlationId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
