{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive-compensation-decided.v1.schema.json",
  "title": "ArchiveCompensationDecided",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "correlationId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "ArchiveCompensationDecided"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveId",
        "decisionVersion",
        "reasonCode"
      ],
      "properties": {
        "archiveId": {
          "type": "string",
          "minLength": 1
        },
        "decisionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
