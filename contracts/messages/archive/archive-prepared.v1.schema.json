{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive-prepared.v1.schema.json",
  "title": "ArchivePrepared",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "correlationId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "ArchivePrepared"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveId",
        "package",
        "packageDigest",
        "manifestDigest"
      ],
      "properties": {
        "archiveId": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "$ref": "../../shared/archive-manifest.v1.schema.json#/$defs/ArtifactRef"
        },
        "packageDigest": {
          "type": "string",
          "minLength": 1
        },
        "manifestDigest": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
