{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/artifact-ref.v1.schema.json",
  "title": "Artifact reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["bucket", "key", "sha256", "sizeBytes"],
  "properties": {
    "bucket": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "versionId": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
